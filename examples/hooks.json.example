{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_HOME:-$HOME/.codex}/agentrelay-env/bin/python\" \"${CODEX_HOME:-$HOME/.codex}/hooks/agent_relay_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_HOME:-$HOME/.codex}/agentrelay-env/bin/python\" \"${CODEX_HOME:-$HOME/.codex}/hooks/agent_relay_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_HOME:-$HOME/.codex}/agentrelay-env/bin/python\" \"${CODEX_HOME:-$HOME/.codex}/hooks/agent_relay_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_HOME:-$HOME/.codex}/agentrelay-env/bin/python\" \"${CODEX_HOME:-$HOME/.codex}/hooks/agent_relay_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_HOME:-$HOME/.codex}/agentrelay-env/bin/python\" \"${CODEX_HOME:-$HOME/.codex}/hooks/agent_relay_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
